---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/AppIcon.astro';
import AppLockup from '../../components/AppLockup.astro';
import CategoryGlyph from '../../components/CategoryGlyph.astro';
import Shelf from '../../components/Shelf.astro';
import Github from '../../components/GithubIcon.astro';
import { getApps } from '../../lib/catalog';
import {
  breadcrumbList,
  getAlternatives,
  getTopics,
  topicForTag,
} from '../../lib/guides';
import { categorySlug, licenseLabel } from '../../lib/collections';
import { appImage } from '../../lib/images';
import { renderMarkdown } from '../../lib/markdown';
import { relatedApps } from '../../lib/related';
import { absoluteUrl, site } from '../../lib/site';
import { ArrowUpRight, Check, ChevronLeft, Copy } from '@lucide/astro';
export function getStaticPaths() {
  return getApps().map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryHref = `categories/${categorySlug(app.category)}/`;
const unmaintained = app.maintenance === 'unmaintained';
const restricted = app.sourceAvailability === 'source-available';
const kind = restricted ? 'source available' : 'open source';
const metaDescription = `${app.summary} ${restricted ? 'Source available' : 'Open source'} under ${app.license}.`;
const replaces = getAlternatives().filter((entry) =>
  app.alternativeTo.includes(entry.slug),
);
const allTopics = getTopics();
const topics = allTopics.filter((topic) =>
  topic.apps.some((other) => other.slug === app.slug),
);
// A tag chip opens the topic page when one lists every app here with that tag.
const tagHref = (tag: string) => {
  const topic = topicForTag(allTopics, tag, app.category);
  return topic
    ? `${base}topics/${topic.slug}/`
    : `${base}search/?tag=${encodeURIComponent(tag)}`;
};
const related = relatedApps(app, getApps());
const descriptionHtml = renderMarkdown(app.body);
const verifiedDate = new Date(`${app.verified}T00:00:00Z`);
const verified = verifiedDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const repository = new URL(app.repository);
const [owner, repo] = repository.pathname.split('/').filter(Boolean);
// Two apps can share a name; the repository owner keeps their titles distinct.
const titleName = getApps().some(
  (other) => other.name === app.name && other.slug !== app.slug,
)
  ? `${app.name} by ${owner}`
  : app.name;
const hosts: Record<string, string> = {
  'github.com': 'GitHub',
  'gitlab.com': 'GitLab',
  'codeberg.org': 'Codeberg',
  'sourceforge.net': 'SourceForge',
  'bitbucket.org': 'Bitbucket',
};
const host =
  hosts[repository.hostname] ?? repository.hostname.replace(/^www\./, '');
const websiteHost = new URL(app.website).hostname.replace(/^www\./, '');
const downloadHost = new URL(app.download).hostname.replace(/^www\./, '');
// The figure shows a resized copy; its link still opens the full-size original.
const shots = await Promise.all(
  app.screenshots.map(async (shot) => ({
    ...shot,
    image: await appImage(app.slug, shot.src, shot.url, [800, 1600]),
  })),
);
// Third-party taps (owner/tap/token) must be trusted before Homebrew will load them.
const [brewOwner, brewTap] = app.homebrew?.includes('/')
  ? app.homebrew.split('/')
  : [];
const brewCommand =
  app.homebrew &&
  `${brewTap ? `brew trust ${brewOwner}/${brewTap} && ` : ''}brew install --cask ${app.homebrew}`;
const brewPage = brewTap
  ? `https://github.com/${brewOwner}/homebrew-${brewTap}`
  : `https://formulae.brew.sh/cask/${app.homebrew}`;
const pageUrl = absoluteUrl(`apps/${app.slug}/`);
const badgeMarkdown = `[![Listed on ${site.name}](${absoluteUrl('badge.svg')})](${pageUrl})`;
---

<Layout
  title={`${titleName} for Mac (${kind}) — ${site.name}`}
  description={metaDescription.length <= 160 ? metaDescription : app.summary}
  type="WebPage"
  section={categoryHref}
  image={app.screenshots[0]?.url}
  imageAlt={app.screenshots[0]?.alt}
  datePublished={app.added}
  lastReviewed={app.verified}
  structuredData={[
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name: app.name,
      description: app.summary,
      url: pageUrl,
      operatingSystem: 'macOS',
      applicationCategory: app.category,
      license: app.licenseUrl,
      downloadUrl: app.download,
      sameAs: [...new Set([app.website, app.repository])].filter(
        (url) => url !== pageUrl,
      ),
      ...(app.iconUrl ? { image: absoluteUrl(app.iconUrl) } : {}),
      ...(app.freeDownload === true
        ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }
        : {}),
    },
    breadcrumbList([
      [app.category, categoryHref],
      [app.name, `apps/${app.slug}/`],
    ]),
  ]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}${categoryHref}`}>
      <ChevronLeft size={16} stroke-width={2.4} />
      {app.category}
    </a>
  </nav>

  <header class="product-head">
    <AppIcon app={app} size={128} eager morph />
    <div class="product-title">
      <h1>{app.name}</h1>
      <p>{app.summary}</p>
      <div class="product-actions">
        <a
          class="button get-large"
          href={app.download}
          aria-label={`Get ${app.name} from the official download page`}
        >
          Get
        </a>
        <a class="button button-secondary" href={app.repository}>
          <Github size={16} />
          View Source
        </a>
        {brewCommand && (
          <div class="brew">
            <code title={brewCommand}>{brewCommand}</code>
            <button
              class="brew-copy"
              type="button"
              data-copy={brewCommand}
              aria-label="Copy Homebrew command"
              hidden
            >
              <Copy class="brew-copy-idle" size={15} />
              <Check class="brew-copy-done" size={15} />
            </button>
            <span class="sr-only" role="status" />
          </div>
        )}
      </div>
      <p
        class:list={['fine-print', { restricted: restricted && !unmaintained }]}
      >
        {licenseLabel(app)}
        {app.freeDownload === true && ' · Free download'}
        {app.freeDownload === false && ' · Paid download'} · Downloads from{' '}
        {downloadHost}
      </p>
    </div>
  </header>

  <dl class="info-strip">
    <div>
      <dt>License</dt>
      <dd class:list={['info-value', { long: app.license.length > 12 }]}>
        {app.license.replaceAll('-only', '')}
      </dd>
      <dd class:list={['info-caption', { restricted }]}>
        {restricted ? 'Source available' : 'Open source'}
      </dd>
    </div>
    <div>
      <dt>Category</dt>
      <dd class="info-value">
        <a href={`${base}${categoryHref}`} aria-label={app.category}>
          <CategoryGlyph category={app.category} size={30} />
        </a>
      </dd>
      <dd class="info-caption">{app.category}</dd>
    </div>
    <div>
      <dt>Source</dt>
      <dd class="info-value">{host}</dd>
      <dd class="info-caption">{owner}</dd>
    </div>
    <div>
      <dt>Verified</dt>
      <dd class="info-value">
        <time datetime={app.verified}>
          {verifiedDate.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </dd>
      <dd class="info-caption">{app.verified.slice(0, 4)}</dd>
    </div>
  </dl>

  {app.screenshots.length > 0 && (
    <Shelf id="screenshots" title="Screenshots" variant="shots">
      {shots.map((shot, index) => (
        <figure class="screenshot">
          <a href={shot.url}>
            <img
              src={shot.image.src}
              srcset={shot.image.srcset}
              sizes="(max-width: 900px) 90vw, 780px"
              alt={shot.alt}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              width="1000"
              height="625"
            />
            <span class="sr-only">Open full-size screenshot</span>
          </a>
          <figcaption>
            Image: <a href={shot.source}>{shot.credit}</a>
          </figcaption>
        </figure>
      ))}
    </Shelf>
  )}

  {restricted && (
    <section class="license-note" aria-labelledby="license-note-title">
      <h2 id="license-note-title">Source available, with restrictions</h2>
      <p>{app.licenseNotes}</p>
      <a href={app.licenseUrl}>
        Read the license <ArrowUpRight size={14} />
      </a>
    </section>
  )}

  {unmaintained && (
    <section class="maintenance-note" aria-labelledby="maintenance-note-title">
      <h2 id="maintenance-note-title">Unmaintained</h2>
      <p>{app.maintenanceNote}</p>
    </section>
  )}

  <section class="section description" aria-labelledby="about-app">
    <h2 id="about-app">About {app.name}</h2>
    <div class="markdown-body" set:html={descriptionHtml} />
  </section>

  <section class="section" aria-labelledby="information">
    <h2 id="information">Information</h2>
    <dl class="information">
      <div>
        <dt>Source code</dt>
        <dd>
          <a href={app.repository}>
            {repo ? `${owner}/${repo}` : owner}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>License</dt>
        <dd>
          <a href={app.licenseUrl}>
            {app.license}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Website</dt>
        <dd>
          <a href={app.website}>
            {websiteHost}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Download</dt>
        <dd>
          <a href={app.download}>
            {downloadHost}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      {app.homebrew && (
        <div>
          <dt>Homebrew</dt>
          <dd>
            <a href={brewPage}>
              {app.homebrew}
              <ArrowUpRight size={13} />
            </a>
          </dd>
        </div>
      )}
      <div>
        <dt>Category</dt>
        <dd>
          <a href={`${base}${categoryHref}`}>{app.category}</a>
        </dd>
      </div>
      {replaces.length > 0 && (
        <div>
          <dt>Alternative to</dt>
          <dd>
            {replaces.map((entry, index) => (
              <>
                {index > 0 && ', '}
                <a href={`${base}alternatives/${entry.slug}/`}>{entry.name}</a>
              </>
            ))}
          </dd>
        </div>
      )}
      {topics.length > 0 && (
        <div>
          <dt>Topics</dt>
          <dd>
            {topics.map((topic, index) => (
              <>
                {index > 0 && ', '}
                <a href={`${base}topics/${topic.slug}/`}>{topic.title}</a>
              </>
            ))}
          </dd>
        </div>
      )}
      <div>
        <dt>Verified</dt>
        <dd>
          <time datetime={app.verified}>{verified}</time>
        </dd>
      </div>
      <div class="information-wide">
        <dt>Tags</dt>
        <dd class="tags">
          {app.tags.map((tag) => (
            <a class="tag" href={tagHref(tag)}>
              {tag.replaceAll('-', ' ')}
            </a>
          ))}
        </dd>
      </div>
    </dl>
    <p class="note">
      {site.name} links to each project’s official download. Check its release
      notes for macOS version and Apple silicon support. The verification date
      records our license and source review, not a security audit. Read{' '}
      <a href={`${base}how-we-verify/`}>how we verify</a>.
    </p>
    <details class="evidence">
      <summary>Sources and image credits</summary>
      <ul>
        {app.sources.map((source) => (
          <li>
            <a href={source}>{source.replace('https://', '')}</a>
          </li>
        ))}
        {app.assets.map((asset) => (
          <li>
            <a href={asset.source}>{asset.path.split('/').pop()}</a>:{' '}
            {asset.credit}. {asset.license}.
          </li>
        ))}
      </ul>
      {app.notices.length > 0 && (
        <>
          <p>License and artwork notices</p>
          <ul>
            {app.notices.map((notice) => (
              <li>
                <a href={notice.url}>{notice.name}</a>
              </li>
            ))}
          </ul>
        </>
      )}
    </details>
    <a
      class="text-link"
      href={`${site.repository}/blob/main/content/apps/${app.slug}/index.md`}
    >
      Improve this listing <ArrowUpRight size={14} />
    </a>
  </section>

  <section class="section badge" aria-labelledby="badge-title">
    <h2 id="badge-title">For the Developer</h2>
    <p class="note">Link to this page from your README with a badge.</p>
    <img
      src={`${base}badge.svg`}
      alt={`Listed on ${site.name}`}
      width="171"
      height="20"
    />
    <div class="brew">
      <code>{badgeMarkdown}</code>
      <button
        class="brew-copy"
        type="button"
        data-copy={badgeMarkdown}
        aria-label="Copy badge Markdown"
        hidden
      >
        <Copy class="brew-copy-idle" size={15} />
        <Check class="brew-copy-done" size={15} />
      </button>
      <span class="sr-only" role="status" />
    </div>
  </section>

  {related.length > 0 && (
    <Shelf
      id="related"
      title="You Might Also Like"
      href={`${base}${categoryHref}`}
    >
      {related.map((other) => (
        <AppLockup app={other} />
      ))}
    </Shelf>
  )}
</Layout>
<script>
  // Without JavaScript the command stays selectable; the copy button needs the Clipboard API.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '.brew-copy',
  )) {
    if (!navigator.clipboard) continue;
    const status = button.nextElementSibling!;
    let reset: ReturnType<typeof setTimeout>;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      button.classList.add('copied');
      status.textContent = 'Copied';
      clearTimeout(reset);
      reset = setTimeout(() => {
        button.classList.remove('copied');
        status.textContent = '';
      }, 1600);
    });
  }
</script>
