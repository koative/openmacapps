---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/AppIcon.astro';
import AppLockup from '../../components/AppLockup.astro';
import CategoryGlyph from '../../components/CategoryGlyph.astro';
import Shelf from '../../components/Shelf.astro';
import Github from '../../components/GithubIcon.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import { getApps } from '../../lib/catalog';
import {
  breadcrumbList,
  getAlternatives,
  getTopics,
  topicForTag,
} from '../../lib/guides';
import {
  archLabels,
  brewCommand as brewInstall,
  categorySlug,
  licenseLabel,
} from '../../lib/collections';
import { formatStars, githubStats } from '../../lib/github';
import { appImage } from '../../lib/images';
import { renderMarkdown } from '../../lib/markdown';
import { relatedApps } from '../../lib/related';
import { absoluteUrl, site } from '../../lib/site';
import {
  Archive,
  ArrowUpRight,
  ChevronLeft,
  ChevronRight,
  ShieldAlert,
  X,
} from '@lucide/astro';
export function getStaticPaths() {
  return getApps().map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryHref = `categories/${categorySlug(app.category)}/`;
const unmaintained = app.maintenance === 'unmaintained';
const restricted = app.sourceAvailability === 'source-available';
const kind = restricted ? 'source available' : 'open source';
const metaDescription = `${app.summary} ${restricted ? 'Source available' : 'Open source'} under ${app.license}.`;
const replaces = getAlternatives().filter((entry) =>
  app.alternativeTo.includes(entry.slug),
);
const allTopics = getTopics();
const topics = allTopics.filter((topic) =>
  topic.apps.some((other) => other.slug === app.slug),
);
// A tag chip opens the topic page when one lists every app here with that tag.
const tagHref = (tag: string) => {
  const topic = topicForTag(allTopics, tag, app.category);
  return topic
    ? `${base}topics/${topic.slug}/`
    : `${base}search/?tag=${encodeURIComponent(tag)}`;
};
const related = relatedApps(app, getApps());
const descriptionHtml = renderMarkdown(app.body);
const verifiedDate = new Date(`${app.verified}T00:00:00Z`);
const verified = verifiedDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const repository = new URL(app.repository);
const [owner, repo] = repository.pathname.split('/').filter(Boolean);
// Two apps can share a name; the repository owner keeps their titles distinct.
const titleName = getApps().some(
  (other) => other.name === app.name && other.slug !== app.slug,
)
  ? `${app.name} by ${owner}`
  : app.name;
const hosts: Record<string, string> = {
  'github.com': 'GitHub',
  'gitlab.com': 'GitLab',
  'codeberg.org': 'Codeberg',
  'sourceforge.net': 'SourceForge',
  'bitbucket.org': 'Bitbucket',
};
const host =
  hosts[repository.hostname] ?? repository.hostname.replace(/^www\./, '');
const websiteHost = new URL(app.website).hostname.replace(/^www\./, '');
const downloadHost = new URL(app.download).hostname.replace(/^www\./, '');
// The figure shows a resized copy; its link still opens the full-size original.
const shots = await Promise.all(
  app.screenshots.map(async (shot) => ({
    ...shot,
    image: await appImage(app.slug, shot.src, shot.url, [800, 1600]),
  })),
);
const [brewOwner, brewTap] = app.homebrew?.includes('/')
  ? app.homebrew.split('/')
  : [];
const brewCommand = app.homebrew && brewInstall([app.homebrew]);
const brewPage = brewTap
  ? `https://github.com/${brewOwner}/homebrew-${brewTap}`
  : `https://formulae.brew.sh/cask/${app.homebrew}`;
const macosLabel = app.macos && `macOS ${app.macos} or later`;
const archLabel = app.arch && archLabels[app.arch];
// Short enough for the info strip on a phone.
const chipShort = {
  both: 'Any Mac',
  'apple-silicon': 'Apple silicon',
  intel: 'Intel only',
} as const;
const github = githubStats(app.slug);
const archived = !unmaintained && !!github?.archived;
// Brand-new projects keep the host here; their count stays under Information.
const stripStars = github && github.stars >= 10 ? github.stars : null;
const shortDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
const pageUrl = absoluteUrl(`apps/${app.slug}/`);
const badgeMarkdown = `[![Listed on ${site.name}](${absoluteUrl('badge.svg')})](${pageUrl})`;
---

<Layout
  title={`${titleName} for Mac (${kind}) — ${site.name}`}
  description={metaDescription.length <= 160 ? metaDescription : app.summary}
  type="WebPage"
  section={categoryHref}
  image={app.screenshots[0]?.url}
  imageAlt={app.screenshots[0]?.alt}
  datePublished={app.added}
  lastReviewed={app.verified}
  structuredData={[
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name: app.name,
      description: app.summary,
      url: pageUrl,
      operatingSystem: macosLabel || 'macOS',
      ...(archLabel ? { processorRequirements: archLabel } : {}),
      applicationCategory: app.category,
      license: app.licenseUrl,
      downloadUrl: app.download,
      sameAs: [...new Set([app.website, app.repository])].filter(
        (url) => url !== pageUrl,
      ),
      ...(app.iconUrl ? { image: absoluteUrl(app.iconUrl) } : {}),
      ...(app.freeDownload === true
        ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }
        : {}),
    },
    breadcrumbList([
      [app.category, categoryHref],
      [app.name, `apps/${app.slug}/`],
    ]),
  ]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}${categoryHref}`}>
      <ChevronLeft size={16} stroke-width={2.4} />
      {app.category}
    </a>
  </nav>

  <header class="product-head">
    <AppIcon app={app} size={128} eager morph />
    <div class="product-title">
      <h1>{app.name}</h1>
      <p>{app.summary}</p>
      <div class="product-actions">
        <a
          class="button get-large"
          href={app.download}
          aria-label={`Get ${app.name} from the official download page`}
        >
          Get
        </a>
        <a class="button button-secondary" href={app.repository}>
          <Github size={16} />
          View Source
        </a>
        {brewCommand && (
          <CopyCommand text={brewCommand} label="Copy Homebrew command" title />
        )}
      </div>
      <p
        class:list={[
          'fine-print',
          { restricted: restricted && !unmaintained && !archived },
        ]}
      >
        {archived ? 'Archived' : licenseLabel(app)}
        {app.freeDownload === true && ' · Free download'}
        {app.freeDownload === false && ' · Paid download'} · Downloads from{' '}
        {downloadHost}
      </p>
    </div>
  </header>

  <dl class="info-strip">
    {(app.macos || app.arch) && (
      <div>
        <dt>{app.macos ? 'macOS' : 'Runs on'}</dt>
        <dd class="info-value">
          {app.macos ? `${app.macos}+` : chipShort[app.arch!]}
        </dd>
        {app.macos && (
          <dd class="info-caption">
            {app.arch ? chipShort[app.arch] : 'Chip unknown'}
          </dd>
        )}
      </div>
    )}
    <div>
      {stripStars !== null ? (
        <>
          <dt>GitHub Stars</dt>
          <dd
            class="info-value"
            aria-label={`${stripStars.toLocaleString('en-US')} stars`}
          >
            {formatStars(stripStars)}
          </dd>
        </>
      ) : (
        <>
          <dt>Source</dt>
          <dd class="info-value">{host}</dd>
        </>
      )}
      <dd class="info-caption">{owner}</dd>
    </div>
    <div>
      <dt>License</dt>
      <dd class:list={['info-value', { long: app.license.length > 9 }]}>
        {app.license.replaceAll('-only', '')}
      </dd>
      <dd class:list={['info-caption', { restricted }]}>
        {restricted ? 'Source available' : 'Open source'}
      </dd>
    </div>
    <div>
      <dt>Verified</dt>
      <dd class="info-value">
        <time datetime={app.verified}>
          {verifiedDate.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </dd>
      <dd class="info-caption">{app.verified.slice(0, 4)}</dd>
    </div>
    <div>
      <dt>Category</dt>
      <dd class="info-value">
        <a href={`${base}${categoryHref}`} aria-label={app.category}>
          <CategoryGlyph category={app.category} size={30} />
        </a>
      </dd>
      <dd class="info-caption">{app.category}</dd>
    </div>
  </dl>

  {app.screenshots.length > 0 && (
    <Shelf id="screenshots" title="Screenshots" variant="shots">
      {shots.map((shot, index) => (
        <figure class="screenshot">
          <a href={shot.url}>
            <img
              src={shot.image.src}
              srcset={shot.image.srcset}
              sizes="(max-width: 900px) 90vw, 780px"
              alt={shot.alt}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              width="1000"
              height="625"
            />
            <span class="sr-only">Open full-size screenshot</span>
          </a>
          <figcaption>
            Image: <a href={shot.source}>{shot.credit}</a>
          </figcaption>
        </figure>
      ))}
    </Shelf>
  )}
  {shots.length > 0 && (
    <dialog class="lightbox" aria-label="Screenshot">
      <img alt="" />
      <button class="lightbox-button close" type="button" aria-label="Close">
        <X size={20} stroke-width={2.4} />
      </button>
      {shots.length > 1 && (
        <>
          <button
            class="lightbox-button prev"
            type="button"
            aria-label="Previous screenshot"
          >
            <ChevronLeft size={22} stroke-width={2.4} />
          </button>
          <button
            class="lightbox-button next"
            type="button"
            aria-label="Next screenshot"
          >
            <ChevronRight size={22} stroke-width={2.4} />
          </button>
        </>
      )}
    </dialog>
  )}

  {restricted && (
    <section class="license-note" aria-labelledby="license-note-title">
      <h2 id="license-note-title">Source available, with restrictions</h2>
      <p>{app.licenseNotes}</p>
      <a href={app.licenseUrl}>
        Read the license <ArrowUpRight size={14} />
      </a>
    </section>
  )}

  {unmaintained && (
    <section class="maintenance-note" aria-labelledby="maintenance-note-title">
      <h2 id="maintenance-note-title">Unmaintained</h2>
      <p>{app.maintenanceNote}</p>
    </section>
  )}

  {archived && (
    <section class="maintenance-note" aria-labelledby="archived-note-title">
      <h2 id="archived-note-title">
        <Archive size={16} stroke-width={2.2} aria-hidden="true" />
        Archived on GitHub
      </h2>
      <p>
        The developer archived the repository, so {app.name} will not get fixes
        or updates. The last commit was on{' '}
        <time datetime={github!.pushed}>{shortDate(github!.pushed)}</time>. The
        current download may still work.
      </p>
    </section>
  )}

  {app.notarized === false && (
    <section class="maintenance-note" aria-labelledby="gatekeeper-note-title">
      <h2 id="gatekeeper-note-title">
        <ShieldAlert size={16} stroke-width={2.2} aria-hidden="true" />
        Not notarized by Apple
      </h2>
      <p>
        macOS blocks the first launch of apps that Apple has not checked. Open{' '}
        {app.name} once, then choose Open Anyway in System Settings under
        Privacy &amp; Security. Do this only if you trust the download source.
      </p>
    </section>
  )}

  <section class="section description" aria-labelledby="about-app">
    <h2 id="about-app">About {app.name}</h2>
    <div class="markdown-body" set:html={descriptionHtml} />
  </section>

  <section class="section" aria-labelledby="information">
    <h2 id="information">Information</h2>
    <dl class="information">
      <div>
        <dt>Source code</dt>
        <dd>
          <a href={app.repository}>
            {repo ? `${owner}/${repo}` : owner}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>License</dt>
        <dd>
          <a href={app.licenseUrl}>
            {app.license}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Website</dt>
        <dd>
          <a href={app.website}>
            {websiteHost}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>Download</dt>
        <dd>
          <a href={app.download}>
            {downloadHost}
            <ArrowUpRight size={13} />
          </a>
        </dd>
      </div>
      {github && (
        <div>
          <dt>GitHub stars</dt>
          <dd>{formatStars(github.stars)}</dd>
        </div>
      )}
      {github?.release && (
        <div>
          <dt>Latest release</dt>
          <dd>
            {github.release.tag} ·{' '}
            <time datetime={github.release.date}>
              {shortDate(github.release.date)}
            </time>
          </dd>
        </div>
      )}
      {github && (
        <div>
          <dt>Last commit</dt>
          <dd>
            <time datetime={github.pushed}>{shortDate(github.pushed)}</time>
          </dd>
        </div>
      )}
      {macosLabel && (
        <div>
          <dt>Requires</dt>
          <dd>{macosLabel}</dd>
        </div>
      )}
      {archLabel && (
        <div>
          <dt>Runs on</dt>
          <dd>{archLabel}</dd>
        </div>
      )}
      {app.notarized !== undefined && (
        <div>
          <dt>Gatekeeper</dt>
          <dd>{app.notarized ? 'Notarized by Apple' : 'Not notarized'}</dd>
        </div>
      )}
      {app.homebrew && (
        <div>
          <dt>Homebrew</dt>
          <dd>
            <a href={brewPage}>
              {app.homebrew}
              <ArrowUpRight size={13} />
            </a>
          </dd>
        </div>
      )}
      <div>
        <dt>Category</dt>
        <dd>
          <a href={`${base}${categoryHref}`}>{app.category}</a>
        </dd>
      </div>
      {replaces.length > 0 && (
        <div>
          <dt>Alternative to</dt>
          <dd>
            {replaces.map((entry, index) => (
              <>
                {index > 0 && ', '}
                <a href={`${base}alternatives/${entry.slug}/`}>{entry.name}</a>
              </>
            ))}
          </dd>
        </div>
      )}
      {topics.length > 0 && (
        <div>
          <dt>Topics</dt>
          <dd>
            {topics.map((topic, index) => (
              <>
                {index > 0 && ', '}
                <a href={`${base}topics/${topic.slug}/`}>{topic.title}</a>
              </>
            ))}
          </dd>
        </div>
      )}
      <div>
        <dt>Verified</dt>
        <dd>
          <time datetime={app.verified}>{verified}</time>
        </dd>
      </div>
      <div class="information-wide">
        <dt>Tags</dt>
        <dd class="tags">
          {app.tags.map((tag) => (
            <a class="tag" href={tagHref(tag)}>
              {tag.replaceAll('-', ' ')}
            </a>
          ))}
        </dd>
      </div>
    </dl>
    <p class="note">
      {site.name} links to each project’s official download.{' '}
      {app.macos && app.arch
        ? 'Requirements are for the current release and can change with the next one.'
        : 'Check its release notes for the macOS version and Apple silicon support.'}{' '}
      The verification date records our license and source review, not a
      security audit. Read <a href={`${base}how-we-verify/`}>how we verify</a>.
    </p>
    <details class="evidence">
      <summary>Sources and image credits</summary>
      <ul>
        {app.sources.map((source) => (
          <li>
            <a href={source}>{source.replace('https://', '')}</a>
          </li>
        ))}
        {app.assets.map((asset) => (
          <li>
            <a href={asset.source}>{asset.path.split('/').pop()}</a>:{' '}
            {asset.credit}. {asset.license}.
          </li>
        ))}
      </ul>
      {app.notices.length > 0 && (
        <>
          <p>License and artwork notices</p>
          <ul>
            {app.notices.map((notice) => (
              <li>
                <a href={notice.url}>{notice.name}</a>
              </li>
            ))}
          </ul>
        </>
      )}
    </details>
    <a
      class="text-link"
      href={`${site.repository}/blob/main/content/apps/${app.slug}/index.md`}
    >
      Improve this listing <ArrowUpRight size={14} />
    </a>
  </section>

  <section class="section badge" aria-labelledby="badge-title">
    <h2 id="badge-title">For the Developer</h2>
    <p class="note">Link to this page from your README with a badge.</p>
    <img
      src={`${base}badge.svg`}
      alt={`Listed on ${site.name}`}
      width="171"
      height="20"
    />
    <CopyCommand text={badgeMarkdown} label="Copy badge Markdown" />
  </section>

  {related.length > 0 && (
    <Shelf
      id="related"
      title="You Might Also Like"
      href={`${base}${categoryHref}`}
    >
      {related.map((other) => (
        <AppLockup app={other} />
      ))}
    </Shelf>
  )}
</Layout>
<script>
  // Opens screenshots over the page; without JavaScript each link still opens the full-size file.
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('.screenshot > a'),
  ];
  if (dialog && links.length) {
    const image = dialog.querySelector('img')!;
    let index = 0;
    const show = (next: number) => {
      index = (next + links.length) % links.length;
      image.src = links[index].href;
      image.alt = links[index].querySelector('img')?.alt ?? '';
    };
    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog
      .querySelector('.close')!
      .addEventListener('click', () => dialog.close());
    dialog
      .querySelector('.prev')
      ?.addEventListener('click', () => show(index - 1));
    dialog
      .querySelector('.next')
      ?.addEventListener('click', () => show(index + 1));
    // A click outside the image, on the backdrop, closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (links.length < 2) return;
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => image.removeAttribute('src'));
  }
</script>
