---
import Layout from '../../layouts/Layout.astro';
import AppLockup from '../../components/AppLockup.astro';
import CollectionLink from '../../components/CollectionLink.astro';
import { getApps, type CatalogApp } from '../../lib/catalog';
import { collections } from '../../lib/collections';
import { appItemList, breadcrumbList } from '../../lib/guides';
import { site } from '../../lib/site';
export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { id: collection.id },
    props: { collection },
  }));
}
const { collection } = Astro.props;
const bySlug = new Map(getApps().map((app) => [app.slug, app]));
const appsOf = (slugs: readonly string[]): CatalogApp[] =>
  slugs.flatMap((slug) => bySlug.get(slug) ?? []);
const apps = appsOf(collection.apps);
const others = collections.filter((entry) => entry.id !== collection.id);
const base = import.meta.env.BASE_URL;
---

<Layout
  title={`${collection.name}: open-source Mac apps — ${site.name}`}
  description={`${collection.description} ${apps.length} hand-picked open-source Mac apps, with license details and official download links.`}
  section={`collections/${collection.id}/`}
  structuredData={[
    appItemList(apps),
    breadcrumbList([[collection.name, `collections/${collection.id}/`]]),
  ]}
>
  <header class="page-head">
    <h1>{collection.name}</h1>
    <p>{collection.description}</p>
  </header>
  <div class="lockup-grid">
    {apps.map((app) => (
      <AppLockup app={app} />
    ))}
  </div>
  <section class="section" aria-labelledby="more-collections">
    <header class="shelf-head">
      <div>
        <h2 id="more-collections">More Collections</h2>
      </div>
    </header>
    <ul class="collection-links">
      {others.map((other) => (
        <CollectionLink
          href={`${base}collections/${other.id}/`}
          name={other.name}
          description={other.description}
          apps={appsOf(other.apps)}
        />
      ))}
    </ul>
  </section>
</Layout>
