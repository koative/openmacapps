---
import Layout from '../../layouts/Layout.astro';
import CategoryGlyph from '../../components/CategoryGlyph.astro';
import CollectionLink from '../../components/CollectionLink.astro';
import { getApps, categories } from '../../lib/catalog';
import { categorySlug } from '../../lib/collections';
import { getTopics, picksFirst } from '../../lib/guides';
import { site } from '../../lib/site';
const apps = getApps();
const topics = getTopics();
const base = import.meta.env.BASE_URL;
---

<Layout
  title={`Open-source Mac apps by category — ${site.name}`}
  description="Browse open-source Mac apps by category and topic: productivity, developer tools, utilities, media, privacy, writing, design, and more."
  section="categories/"
>
  <header class="page-head">
    <h1>Categories</h1>
  </header>
  <ul class="category-grid category-grid-large">
    {categories.map((category) => {
      const inCategory = apps.filter((app) => app.category === category);
      return (
        <li>
          <a
            class="category-tile"
            href={`${base}categories/${categorySlug(category)}/`}
          >
            <CategoryGlyph category={category} size={44} />
            <span>{category}</span>
            <span class="count">{inCategory.length} apps</span>
          </a>
        </li>
      );
    })}
  </ul>
  {topics.length > 0 && (
    <section class="section" aria-labelledby="topics-title">
      <header class="shelf-head">
        <div>
          <h2 id="topics-title">Browse by Topic</h2>
        </div>
        <div class="shelf-actions">
          <a class="see-all" href={`${base}topics/`}>
            See All<span class="sr-only"> topics</span>
          </a>
        </div>
      </header>
      <ul class="collection-links">
        {topics.map((topic) => (
          <CollectionLink
            href={`${base}topics/${topic.slug}/`}
            name={topic.title}
            description={`${topic.apps.length} apps`}
            apps={picksFirst(topic.apps)}
          />
        ))}
      </ul>
    </section>
  )}
</Layout>
