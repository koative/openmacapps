---
import Layout from '../../layouts/Layout.astro';
import AppLockup from '../../components/AppLockup.astro';
import CollectionLink from '../../components/CollectionLink.astro';
import { ArrowUpRight, ChevronLeft } from '@lucide/astro';
import {
  allFree,
  appItemList,
  breadcrumbList,
  describeApps,
  getAlternatives,
  picksFirst,
  sourceCount,
} from '../../lib/guides';
import { renderMarkdown } from '../../lib/markdown';
import { site } from '../../lib/site';
export function getStaticPaths() {
  return getAlternatives().map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const apps = picksFirst(entry.apps);
const related = getAlternatives()
  .filter(
    (other) => other.category === entry.category && other.slug !== entry.slug,
  )
  .sort((a, b) => b.apps.length - a.apps.length);
const base = import.meta.env.BASE_URL;
const restricted = apps.some(
  (app) => app.sourceAvailability === 'source-available',
);
// "Free" only when every listed app's official download was checked and costs nothing.
const free = !restricted && allFree(apps);
const lead = free ? 'Free, open-source' : 'Open-source';
const kind = restricted
  ? 'Mac apps with published source'
  : `${lead.toLowerCase()} Mac apps`;
---

<Layout
  title={
    entry.onMac
      ? `${lead} ${entry.name} alternatives for Mac — ${site.name}`
      : `${entry.name} for Mac: ${lead.toLowerCase()} alternatives — ${site.name}`
  }
  description={describeApps(
    entry.onMac
      ? `${apps.length} ${kind} that replace ${entry.name}: `
      : `${entry.name} has no macOS version. ${apps.length} ${kind} do the same job: `,
    apps,
  )}
  section="alternatives/"
  structuredData={[
    appItemList(apps),
    breadcrumbList([
      ['Alternatives', 'alternatives/'],
      [entry.name, `alternatives/${entry.slug}/`],
    ]),
  ]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}alternatives/`}>
      <ChevronLeft size={16} stroke-width={2.4} />
      Alternatives
    </a>
  </nav>
  <header class="page-head">
    <h1>
      {entry.onMac
        ? `${lead} alternatives to ${entry.name}`
        : `${entry.name} for Mac`}
    </h1>
    <p>
      {entry.summary}
      {!entry.onMac && ' It has no macOS version.'}
    </p>
  </header>
  <div>
    <div class="markdown-body" set:html={renderMarkdown(entry.body)} />
    <a class="text-link" href={entry.website}>
      {entry.name} website <ArrowUpRight size={14} />
    </a>
  </div>
  <section class="section" aria-labelledby="apps-title">
    <header class="shelf-head">
      <div>
        <h2 id="apps-title">Apps That Replace {entry.name}</h2>
        <p>{sourceCount(apps, 'alternatives')}</p>
      </div>
    </header>
    <div class="lockup-grid">
      {apps.map((app) => (
        <AppLockup app={app} />
      ))}
    </div>
  </section>
  {related.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <header class="shelf-head">
        <div>
          <h2 id="related-title">More {entry.category} Alternatives</h2>
        </div>
        <div class="shelf-actions">
          <a class="see-all" href={`${base}alternatives/`}>
            See All<span class="sr-only"> alternatives</span>
          </a>
        </div>
      </header>
      <ul class="collection-links">
        {related.map((other) => (
          <CollectionLink
            href={`${base}alternatives/${other.slug}/`}
            name={other.name}
            description={`${other.apps.length} open-source alternatives`}
            apps={picksFirst(other.apps)}
          />
        ))}
      </ul>
    </section>
  )}
</Layout>
