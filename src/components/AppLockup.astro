---
import AppIcon from './AppIcon.astro';
import type { CatalogApp } from '../lib/catalog';
import { licenseLabel } from '../lib/collections';
interface Props {
  app: CatalogApp;
  /** Adds the data attributes the search page filters on that the card does not show as text. */
  searchable?: boolean;
  /** Names of the proprietary products the app replaces; searchable text only. */
  replaces?: string[];
}
const { app, searchable = false, replaces = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const unmaintained = app.maintenance === 'unmaintained';
const restricted =
  !unmaintained && app.sourceAvailability === 'source-available';
// Search reads the name, summary and license from the card's text; only the
// exceptions are marked for featured apps and restricted licenses.
const filters = searchable
  ? {
      'data-app': '',
      'data-category': app.category,
      'data-tags': app.tags.join(','),
      'data-added': app.added,
      'data-featured': app.featured ? '' : undefined,
      'data-source':
        app.sourceAvailability === 'open-source'
          ? undefined
          : app.sourceAvailability,
      'data-replaces': replaces.length ? replaces.join(' ') : undefined,
    }
  : {};
---

<article class="lockup" {...filters}>
  <a class="lockup-link" href={`${base}apps/${app.slug}/`}>
    <AppIcon app={app} size={64} />
    <div class="lockup-text">
      <h3>{app.name}</h3>
      <span class="lockup-summary">{app.summary}</span>
    </div>
  </a>
  <div class="lockup-get">
    <a
      class="get"
      href={app.download}
      aria-label={`Get ${app.name} from the official download page`}
    >
      Get
    </a>
    <span class:list={['fine-print', { restricted }]}>{licenseLabel(app)}</span>
  </div>
</article>
